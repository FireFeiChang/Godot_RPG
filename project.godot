; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Test-ARPG"
run/main_scene="res://UI/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PlayerStates="*res://Player/player_states.tscn"
Dialog="*res://Player/dialog.gd"
TaskManager="*res://tasks/task_manager.tscn"
SaveManager="*res://save/save_manager.tscn"
Inventory="*res://inventory/inventory_manager.gd"
Wallet="*res://coins/wallet.gd"
DialogueManager="*uid://c3rodes2l3gxb"
HUD="*res://UI/hud.tscn"
MapManager="*res://maps/map_manager.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/hasturoperationgd/plugin.cfg")

